# Copy to ".env" (in the backend/ folder or the folder you run the CLI from) and fill in what you need.
# ".env" is git-ignored. Never commit it, paste it into chat, or share screenshots of it.

# --- Live AI reviews (optional; demo mode needs none of this) ---
# Any OpenAI-compatible provider works. OpenRouter is the default.
LLM_API_KEY=your-api-key-here
# LLM_BASE_URL=https://openrouter.ai/api/v1
# REVIEW_MODEL=deepseek/deepseek-v4.1-flash
# SECURITY_MODEL=
# MAINTAINABILITY_MODEL=

# --- Hosting policy ---
# Set to false on a public deployment: the server then never calls an AI provider (demo only).
ENABLE_LIVE_REVIEW=true
# Comma-separated browser origins allowed to call the API during development.
# CORS_ORIGINS=http://localhost:5173
# Live reviews allowed per client IP per minute.
# LIVE_RATE_LIMIT_PER_MINUTE=6

# --- Limits ---
# MAX_CODE_CHARS=60000
# REQUEST_TIMEOUT_SECONDS=120
